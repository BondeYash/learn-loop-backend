# Enter private credentials directly into .env, never in chat or source control.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/lms
MONGO_DB_NAME=lms
CLIENT_URL=http://localhost:5173

# New uploads go directly from the browser to private R2.
VIDEO_STORAGE_PROVIDER=r2
MAX_VIDEO_BYTES=2147483648
UPLOAD_URL_TTL_SECONDS=900
PLAYBACK_URL_TTL_SECONDS=300
ENABLE_LEGACY_VIDEO_WORKER=false

# Keep public r2.dev/custom-domain access disabled. Restrict credentials to this bucket.
# Apply docs/r2-local-cors.json for local development; use only verified origins in production.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional migration support for older chunked uploads only (off by default).
# Requires persistent staging and FFmpeg/FFprobe when explicitly enabled.
# VIDEO_STORAGE_DIR=storage/videos
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Optional thumbnails
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional password-reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=LMS Platform <no-reply@lms.com>

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1200
AUTH_RATE_LIMIT_MAX=30
